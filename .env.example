# Copy to .env and fill in your key. Loaded once at startup by src/core/config/env.ts
# — see that file for the ordering constraint (must load before the Claude Agent SDK is imported).
ANTHROPIC_API_KEY=
# Cliente A2A saliente (Hito 6, src/adapters/a2a/config.ts). Todas opcionales, comentadas por
# defecto — con el interruptor apagado el comportamiento es idéntico a v2.1.0.
# Interruptor opt-in: sólo "on" (tras trim + lowercase) activa el mecanismo. Default: apagado.
# HARNESS_A2A_SALIENTE=
# URL base (Agent Card) del destino "riesgo-credito". Sin default — ausente/undefined = destino no disponible.
# HARNESS_A2A_ENDPOINT_RIESGO_CREDITO=
# URL base (Agent Card) del destino "kpi-incidente". Sin default — ausente/undefined = destino no disponible.
# HARNESS_A2A_ENDPOINT_KPI_INCIDENTE=
# Bearer token opcional para "riesgo-credito". Nunca aparece en un log ni en un mensaje.
# HARNESS_A2A_TOKEN_RIESGO_CREDITO=
# Bearer token opcional para "kpi-incidente". Nunca aparece en un log ni en un mensaje.
# HARNESS_A2A_TOKEN_KPI_INCIDENTE=
# Timeout (ms) por request JSON-RPC individual. Default: 30000.
# HARNESS_A2A_REQUEST_TIMEOUT_MS=
# Intervalo (ms) entre consultas del loop de polling de GetTask. Default: 1500.
# HARNESS_A2A_POLL_INTERVAL_MS=
# Timeout total (ms) del loop de polling antes de CancelTask + reason "timeout". Default: 120000.
# HARNESS_A2A_TASK_TIMEOUT_MS=

# Umbral de venta grande (src/core/ventas/ventas-config.ts). A partir de este monto, registrarVenta
# dispara una consulta de riesgo/crédito no bloqueante hacia "riesgo-credito". Default: 5000.
# VENTA_GRANDE_UMBRAL=
