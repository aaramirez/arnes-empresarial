# Copy to .env and fill in your key. Loaded once at startup by src/core/config/env.ts
# — see that file for the ordering constraint (must load before the Claude Agent SDK is imported).
ANTHROPIC_API_KEY=
# Cliente A2A saliente (Hito 6, src/adapters/a2a/config.ts). Todas opcionales, comentadas por
# defecto — con el interruptor apagado el comportamiento es idéntico a v2.1.0.
# Interruptor opt-in: sólo "on" (tras trim + lowercase) activa el mecanismo. Default: apagado.
# HARNESS_A2A_SALIENTE=
# URL base (Agent Card) del destino "riesgo-credito". Sin default — ausente/undefined = destino no disponible.
# HARNESS_A2A_ENDPOINT_RIESGO_CREDITO=
# URL base (Agent Card) del destino "kpi-incidente". Sin default — ausente/undefined = destino no disponible.
# HARNESS_A2A_ENDPOINT_KPI_INCIDENTE=
# Bearer token opcional para "riesgo-credito". Nunca aparece en un log ni en un mensaje.
# HARNESS_A2A_TOKEN_RIESGO_CREDITO=
# Bearer token opcional para "kpi-incidente". Nunca aparece en un log ni en un mensaje.
# HARNESS_A2A_TOKEN_KPI_INCIDENTE=
# Timeout (ms) por request JSON-RPC individual. Default: 30000.
# HARNESS_A2A_REQUEST_TIMEOUT_MS=
# Intervalo (ms) entre consultas del loop de polling de GetTask. Default: 1500.
# HARNESS_A2A_POLL_INTERVAL_MS=
# Timeout total (ms) del loop de polling antes de CancelTask + reason "timeout". Default: 120000.
# HARNESS_A2A_TASK_TIMEOUT_MS=

# Umbral de venta grande (src/core/ventas/ventas-config.ts). A partir de este monto, registrarVenta
# dispara una consulta de riesgo/crédito no bloqueante hacia "riesgo-credito". Default: 5000.
# VENTA_GRANDE_UMBRAL=

# Servidor A2A entrante (Hito 7, src/adapters/a2a/server-config.ts). Todas opcionales, comentadas
# por defecto — con el token vacío el comportamiento es idéntico a v2.2.0 (cero puertos abiertos).
# Interruptor: el único gate es el token no vacío (tras trim). Default: apagado.
# HARNESS_A2A_ENTRANTE_TOKEN=
# Puerto de escucha del servidor A2A entrante. Default: 8888.
# HARNESS_A2A_ENTRANTE_PORT=
# URL pública base, usada en el Agent Card (supportedInterfaces[0].url). Default: http://localhost:8888.
# HARNESS_A2A_ENTRANTE_PUBLIC_URL=
# Tope de tamaño del body HTTP en bytes. Default: 65536 (64 KiB).
# HARNESS_A2A_ENTRANTE_MAX_BODY_BYTES=
# Tope de turnos en vuelo simultáneos. Default: 4.
# HARNESS_A2A_ENTRANTE_MAX_EN_VUELO=

# Board / GitHub (`src/adapters/board/config.ts`). Adaptador DESHABILITADO si el token está vacío — sin PRs de bot.
# Bearer token de la app/bot de GitHub. Nunca aparece en un log ni en un comentario.
# GITHUB_TOKEN=
# Base URL de la API de GitHub. Default: https://api.github.com.
# GITHUB_API_BASE_URL=
# Timeout (ms) por request a la API de GitHub. Default: 10000.
# BOARD_TIMEOUT_MS=

# Git CLI y worktrees aislados de escritura delegada (`src/adapters/git/config.ts`, Hito 5.1).
# Binario de git a invocar. Default: git.
# HARNESS_GIT_BIN=
# Timeout (ms) por invocación de git. Default: 30000.
# HARNESS_GIT_TIMEOUT_MS=
# Directorio raíz donde se crean los worktrees aislados. Default: .harness/worktrees.
# HARNESS_WORKTREE_ROOT=
# TTL (ms) de un worktree ocioso antes de que el barrido lo reclame. Default: 7200000 (2 h).
# HARNESS_WORKTREE_TTL_MS=
# Timeout (ms) de una corrida completa de la suite de tests dentro de un worktree. Default: 300000 (5 min).
# HARNESS_WORKTREE_TEST_TIMEOUT_MS=

# Graphify CLI (`src/adapters/knowledge/config.ts`).
# Binario de graphify a invocar. Default: graphify.
# GRAPHIFY_BIN=
# Ruta al grafo ya extraído. Default: graphify-out/graph.json.
# GRAPHIFY_GRAPH_PATH=
# Presupuesto de tokens por query/explain/path. Default: 200.
# GRAPHIFY_BUDGET=
# Timeout (ms) por invocación de graphify. Default: 15000.
# GRAPHIFY_TIMEOUT_MS=

# Notificaciones por email (`src/adapters/notificaciones/config.ts`). Adaptador DESHABILITADO si la API key está vacía — no-op que loguea el link.
# API key del proveedor de email (Resend). Nunca aparece en un log ni en un mensaje.
# EMAIL_API_KEY=
# Remitente del email. Default: arnes@localhost.
# EMAIL_FROM=
# URL de la API del proveedor de email. Default: https://api.resend.com/emails.
# EMAIL_API_URL=
# Timeout (ms) por request al proveedor de email. Default: 10000.
# EMAIL_TIMEOUT_MS=

# Adaptador web (`src/adapters/web/config.ts`). `WEB_PORT=0` (o ausente) = DESHABILITADO, no se abre ningún puerto.
# Puerto de escucha del servidor web. Default: 0 (deshabilitado).
# WEB_PORT=
# URL pública base para armar links (confirmación de venta, etc). Default: http://localhost:8080.
# WEB_PUBLIC_URL=
# Bearer token que gatea POST /ventas. Vacío = esa ruta responde 401 SIEMPRE (nunca "abierta por defecto").
# VENTAS_API_TOKEN=
# Tope de tamaño del body HTTP en bytes. Default: 65536 (64 KiB).
# WEB_MAX_BODY_BYTES=

# Webhooks de GitHub (`src/adapters/webhooks/config.ts`). Adaptador DESHABILITADO si el secreto está vacío.
# Secreto compartido para validar la firma HMAC del webhook. Nunca aparece en un log.
# GITHUB_WEBHOOK_SECRET=
# Puerto de escucha del servidor de webhooks. Default: 8787.
# WEBHOOK_PORT=
# Path de la ruta que recibe el webhook. Default: /webhooks/github.
# WEBHOOK_PATH=
# Tope de tamaño del body HTTP en bytes. Default: 1048576 (1 MiB).
# WEBHOOK_MAX_BODY_BYTES=

# Delegación por roles (Hito 5, `src/build-on-activity.ts`). Interruptor de degradación — el núcleo no lo conoce.
# "off" = handleTurn único de v1.4.0/Hito 3. Cualquier otro valor o AUSENTE = delegación Planner→Developer→Reviewer ACTIVA (default).
# HARNESS_DELEGACION_ROLES=
# "off" = escritura delegada DESACTIVADA (sin worktree, sin propuesta de patch). Cualquier otro valor o AUSENTE = ACTIVA (default).
# HARNESS_ESCRITURA_DELEGADA=

# Sesión de empleado (`src/core/auth/auth-config.ts`, ADR 31, ADR 231, devolucion-sin-token-dos-personas). Las dos son independientes: `0` en una no afecta el significado de la otra.
# Tope ABSOLUTO desde el login, NO se renueva nunca. `0` = sin expiración. Default: 480 (8 h). Inválida: ABORTA.
# SESION_TTL_MINUTOS=
# ★ Vencimiento por INACTIVIDAD, se renueva con cada uso. `0` = sin expiración por inactividad. Default: 30. Inválida: ABORTA.
# SESION_INACTIVIDAD_MINUTOS=

# Reglas de negocio de ventas (`src/core/ventas/ventas-config.ts`, Hito 4). Inválida en cualquiera de las cuatro: ABORTA.
# Porcentaje de comisión, en (0, 1]. Default: 0.1.
# COMISION_PORCENTAJE=
# Umbral de reembolso: monto < umbral auto-aprueba, >= escala. Default: 500.
# REEMBOLSO_UMBRAL=
# Horas de vigencia del token de confirmación de venta. `0` = sin vencimiento. Default: 72.
# VENTA_TOKEN_TTL_HORAS=
